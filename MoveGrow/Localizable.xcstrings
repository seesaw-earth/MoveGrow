    "Legs: above 0 they bend and stretch together, below 0 they alternate. Sync: how much the four limbs speed up and slow down together. 3D videos only." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legs: above 0 they bend and stretch together, below 0 they alternate. Sync: how much the four limbs speed up and slow down together. 3D videos only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piernas: por encima de 0 se doblan y estiran a la vez, por debajo de 0 alternan. Sincronía: cuánto aceleran y frenan juntas las cuatro extremidades. Solo videos en 3D."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双腿：高于 0 表示一起屈伸，低于 0 表示交替。同步：四肢一起加速和减速的程度。仅限 3D 视频。"
          }
        }
      }
    },
