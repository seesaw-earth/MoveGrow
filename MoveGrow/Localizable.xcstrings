          }
        }
      }
    },
    "MoveGrow does not require an account and does not upload your baby’s videos, profile, pose data, movement summaries or milestones to a MoveGrow server." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MoveGrow does not require an account and does not upload your baby’s videos, profile, pose data, movement summaries or milestones to a MoveGrow server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MoveGrow no necesita una cuenta y no sube los videos, el perfil, los datos de postura, los resúmenes de movimiento ni los hitos de tu bebé a ningún servidor de MoveGrow."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MoveGrow 不需要账户，也不会把宝宝的视频、资料、姿态数据、动作摘要或里程碑上传到 MoveGrow 服务器。"
          }
        }
      }
    },
    "MoveGrow follows the largest person in the picture, so keep everyone else out of it." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MoveGrow follows the largest person in the picture, so keep everyone else out of it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MoveGrow sigue a la persona más grande de la imagen: deja a los demás fuera."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MoveGrow 分析的是画面里最大的那个人，所以别让其他人入镜。"
          }
        }
      }
    },
    "MoveGrow growth" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MoveGrow growth"
          }
        },
        "es" : {
