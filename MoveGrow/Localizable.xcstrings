    "InstantHMR fits a 3D body model to every frame: steady keypoints, true 3D angles and how far hands and feet are lifted. YOLO finds keypoints in 2D. New videos use the engine chosen here." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InstantHMR fits a 3D body model to every frame: steady keypoints, true 3D angles and how far hands and feet are lifted. YOLO finds keypoints in 2D. New videos use the engine chosen here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InstantHMR ajusta un modelo corporal 3D a cada fotograma: puntos clave estables, ángulos 3D reales y cuánto se elevan las manos y los pies. YOLO encuentra los puntos clave en 2D. Los videos nuevos usan el motor elegido aquí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InstantHMR 为每一帧拟合 3D 人体模型：关键点稳定，能得到真实的 3D 角度，以及手脚抬起的高度。YOLO 只在 2D 画面中找关键点。新视频会使用这里选择的引擎。"
          }
        }
      }
    },
    "InstantHMR source" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
