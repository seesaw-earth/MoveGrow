    "No account and no cloud processing. Videos, movement data and summaries are stored on this iPhone and excluded from automatic backup. Export the videos you want to keep before switching phones or deleting the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No account and no cloud processing. Videos, movement data and summaries are stored on this iPhone and excluded from automatic backup. Export the videos you want to keep before switching phones or deleting the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta y sin procesamiento en la nube. Los videos, los datos de movimiento y los resúmenes se guardan en este iPhone y no se incluyen en la copia de seguridad automática. Exporta los videos que quieras conservar antes de cambiar de teléfono o eliminar la app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需账户，也不在云端处理。视频、动作数据和摘要都保存在这台 iPhone 上，不会被自动备份。换手机或删除 App 之前，请先导出想保留的视频。"
          }
        }
      }
    },
    "No account. No automatic uploads. Videos stay in this app on this device. Deleting the app or losing your phone can remove your memories; export the ones you want to keep." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No account. No automatic uploads. Videos stay in this app on this device. Deleting the app or losing your phone can remove your memories; export the ones you want to keep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta. Sin subidas automáticas. Los videos se quedan en esta app, en este dispositivo. Si eliminas la app o pierdes el teléfono, podrías perder tus recuerdos; exporta los que quieras conservar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需账户，不会自动上传。视频只保存在这台设备的 App 里。删除 App 或丢失手机可能会让回忆丢失，请导出想保留的视频。"
          }
        }
      }
    },
