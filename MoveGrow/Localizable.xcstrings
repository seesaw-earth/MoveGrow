        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以直接在 MoveGrow 里录制，也可以从“照片”里选已经拍好的视频。两种方式都只在这台 iPhone 上分析，视频不会离开手机。"
          }
        }
      }
