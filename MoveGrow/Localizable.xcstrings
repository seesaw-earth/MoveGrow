    "YOLO26l-pose finds the baby for InstantHMR in every frame. These are its own 2D keypoints, for comparison; the analysis uses InstantHMR." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOLO26l-pose finds the baby for InstantHMR in every frame. These are its own 2D keypoints, for comparison; the analysis uses InstantHMR."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOLO26l-pose localiza al bebé para InstantHMR en cada fotograma. Estos son sus propios puntos clave 2D, para comparar; el análisis usa InstantHMR."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOLO26l-pose 在每一帧里为 InstantHMR 找到宝宝。这里是它自己的 2D 关键点，仅供对比；分析使用的是 InstantHMR。"
          }
        }
      }
    },
