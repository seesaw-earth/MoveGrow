    "NSCameraUsageDescription" : {
      "comment" : "Camera permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MoveGrow uses the camera to record your baby's movement videos. They are analysed on this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MoveGrow usa la cámara para grabar videos del movimiento de tu bebé. Se analizan en este iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MoveGrow 使用相机录制宝宝的动作视频，视频只在这台 iPhone 上分析。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Photos add-only permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MoveGrow saves the videos and images you export to your photo library when you tap Save to Photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MoveGrow guarda en tu fototeca los videos y las imágenes que exportas cuando tocas Guardar en Fotos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你轻点“存储到‘照片’”时，MoveGrow 会把你导出的视频和图片存储到照片图库。"
          }
        }
      }
    }
  },
  "version" : "1.0"
