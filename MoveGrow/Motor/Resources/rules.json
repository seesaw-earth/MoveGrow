        "min_turned_frac": {
          "value": 0.4,
          "unit": "fraction",
          "origin": "engineering_prior"
        },
        "min_abs_pi": {
          "value": 0.6,
          "unit": "index",
          "origin": "engineering_prior",
          "note": "(T_left - T_right)/(T_left + T_right)"
        }
      },
